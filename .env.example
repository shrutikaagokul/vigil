# VIGIL Environment Variables
# Copy to .env and fill in values

# Database (default: SQLite)
DATABASE_URL=sqlite:///vigil.db

# Notification mode: "console" or "sns"
NOTIFICATION_MODE=console

# AWS SNS (only needed if NOTIFICATION_MODE=sns)
SNS_TOPIC_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Debug mode
DEBUG=false
