# Vigil Frontend – environment variables
# Copy this file to .env.local and customise for your environment.
# .env.local is gitignored and will NOT be committed.

# Backend base URL. Leave empty to use the Vite dev proxy (localhost:8000).
# Example for remote backend:  VITE_API_BASE_URL=https://api.vigil.example.com
VITE_API_BASE_URL=
